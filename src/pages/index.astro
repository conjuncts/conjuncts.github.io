---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h3>Hello, traveler!</h3>
			<p>
				Welcome! I am <strong>conjuncts</strong>. Here are some things I've made:
			</p>
			<ul>
				<li><a href="https://github.com/conjuncts/gmft">gmft</a> (<i>give me formatted tables</i>), 
					a package for deep and quick PDF table extraction
					<img src="https://img.shields.io/github/stars/conjuncts/gmft" class="github-shield" alt="GitHub Repo stars">
				</li>
				<li><a href="https://readxkcd.com">readxkcd</a>, which remembers which xkcds you have read
				</li>
				<li><a href="https://conjuncts.github.io/vowelchart">vowelchart</a>, a infographic on vowel formant frequencies
				built with d3.js</li>
			</ul>
			<p>
				Please check out my <a href="/blog">blog</a>!
			</p>
		</main>
		<Footer />
	</body>
</html>
